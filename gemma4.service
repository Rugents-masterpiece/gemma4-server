[Unit]
Description=Gemma 4 26B-A4B llama.cpp Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rugent
Group=rugent
WorkingDirectory=/home/rugent/gemma4-server
Environment=LLAMA_CTX=131072
Environment=LLAMA_PARALLEL=2
Environment=LLAMA_N_CPU_MOE=6
Environment=LLAMA_CTK=q8_0
Environment=LLAMA_CTV=q5_1
Environment=LLAMA_FIT=off
Environment=LLAMA_USE_C=0
ExecStart=/home/rugent/gemma4-server/serve.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGINT
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
